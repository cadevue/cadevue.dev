---
import { Image } from "astro:assets";
import { getCollection, type CollectionEntry } from "astro:content";
import avatar from "../assets/avatar.jpg";

type Blog = CollectionEntry<'blog'>;
type Series = CollectionEntry<'series'>;

const allSeries = await getCollection('series');
const allPosts = await getCollection('blog', ({ data }: Blog) => !data.draft);

const sortedSeries = allSeries.sort((a: Series, b: Series) => b.data.priority - a.data.priority);

const sidebarData = sortedSeries
  .map((s: Series) => ({
    series: s,
    posts: allPosts
      .filter((p: Blog) => p.data.series === s.id)
      .sort((a: Blog, b: Blog) => {
        const ao = a.data.seriesOrder ?? 0;
        const bo = b.data.seriesOrder ?? 0;
        if (ao !== bo) return ao - bo;
        return b.data.pubDate.getTime() - a.data.pubDate.getTime();
      }),
  }))
  .filter(({ posts }: { posts: Blog[] }) => posts.length > 0);
---
<aside class="text-base text-ink-dim">
  <div class="mb-8 flex mr-8">
    <Image src={avatar} alt="Cadevue Avatar" aria-label="Cadevue Avatar" class="w-48 aspect-square rounded-full" loading="eager" fetchpriority="high" />
  </div>

  <nav class="space-y-6">
    {sidebarData.map(({ series: s, posts }: { series: Series; posts: Blog[] }) => (
      <section>
        <h2 class="mb-2 font-semibold text-ink">{s.data.title}</h2>
        <ul class="space-y-2">
          {posts.map((p: Blog) => (
            <li>
              <a href={'/' + p.id.replace(/\/index$/, '')}>
                {p.data.title}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </nav>
</aside>
