---
import '../styles/global.css';
import type { MarkdownHeading } from 'astro';
import Header from '../components/Header.astro';
import SidebarLeft from '../components/SidebarLeft.astro';
import SidebarRight from '../components/SidebarRight.astro';

interface Props {
  title: string;
  description?: string;
  headings?: MarkdownHeading[];
  seriesId?: string;
}

const { title, description, headings, seriesId } = Astro.props;
---
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon-48x48.png" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lexend:wght@100..900&family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&family=Roboto+Mono:ital,wght@0,100..700;1,100..700&display=swap" rel="stylesheet">
    <title>{title} — Cadevue's Journal</title>
    {description && <meta name="description" content={description} />}
  </head>
  <body>
    <Header />
    <div class="mx-auto grid max-w-3xl sm:max-w-360 gap-10 px-7 py-10 lg:grid-cols-[16rem_minmax(0,48rem)_16rem] lg:items-start">
      <SidebarLeft />
      <main class="min-w-0">
        <slot />
      </main>
      <SidebarRight headings={headings} seriesId={seriesId} />
    </div>
  </body>
</html>
