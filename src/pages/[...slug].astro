---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }: CollectionEntry<'blog'>) => !data.draft);
  return posts.filter((post) => post.id !== 'about-me').map((post) => ({
    params: { slug: post.id.replace(/\/index$/, '') },
    props: { post },
  }));
}

type Props = { post: CollectionEntry<'blog'> };

const { post } = Astro.props;
const { Content, headings } = await render(post);
---
<Base
  title={post.data.title}
  description={post.data.description}
  headings={headings}
  seriesId={post.data.series}
>
  <article class="font-body">
    <h1 class="font-sans text-4xl font-semibold text-ink mb-6">{post.data.title}</h1>
    <div class="text-ink-dim leading-relaxed space-y-4">
      <Content />
    </div>
  </article>
</Base>
