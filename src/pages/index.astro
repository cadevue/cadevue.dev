---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';

const post = await getEntry('blog', 'about-me');
if (!post) throw new Error("'about-me' blog entry not found");
const { Content, headings } = await render(post);
---
<Base
  title={post.data.title}
  description={post.data.description}
  headings={headings}
  seriesId={post.data.series}
>
  <article class="font-body">
    <h1 class="font-sans text-4xl font-semibold text-ink mb-6">{post.data.title}</h1>
    <div class="text-ink-dim leading-relaxed space-y-4">
      <Content />
    </div>
  </article>
</Base>
